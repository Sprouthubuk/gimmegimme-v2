# Gimme Gimme Prizes — Laravel API and admin. On Forge, paste this into Site → Environment and fill in the blanks.
APP_NAME="Gimme Gimme Prizes"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gimmegimmeprizes.co.uk
FRONTEND_URL=https://gimmegimmeprizes.co.uk
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gimme
DB_USERNAME=forge
DB_PASSWORD=

# Cookie sessions shared with the Astro site on the same domain.
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_COOKIE=gimme_session
SESSION_DOMAIN=gimmegimmeprizes.co.uk
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=gimmegimmeprizes.co.uk

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
API_RATE_PER_MINUTE=300

# Email (Resend's SMTP, or any SMTP).
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@gimmegimmeprizes.co.uk"
MAIL_FROM_NAME="Gimme Gimme Prizes"
CONTACT_INBOX=hello@gimmegimmeprizes.co.uk

# Cashflows hosted payment page. CASHFLOWS_ENV=integration for the sandbox.
CASHFLOWS_DRIVER=cashflows
CASHFLOWS_ENV=production
CASHFLOWS_CONFIGURATION_ID=
CASHFLOWS_API_KEY=

# Verity (see vendor/sprouthub/verity-engine/INTEGRATION.md §4). Generate before the first competition,
# keep an offline copy of each, never change them afterwards.
#   php artisan verity:seal-seeds --new-key          -> VERITY_SEED_KEY
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;" -> VERITY_OWNER_PEPPER
VERITY_BEACON=drand
VERITY_SEED_KEY=
VERITY_OWNER_PEPPER=
VERITY_VERIFY_URL=https://gimmegimmeprizes.co.uk/verify
VERITY_ROUTES=true
VERITY_TSA_URL=https://freetsa.org/tsr
VERITY_ANCHOR_EMAILS=
VERITY_ALERT_EMAILS=
