{
  "name": "gimmegimme-frontend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock-api": "node ./mock-api/server.mjs",
    "test:fullstack": "vitest run --config vitest.fullstack.config.ts",
    "test:visual": "vitest run --config vitest.visual.config.ts"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.5",
    "@astrojs/react": "^4.4.2",
    "astro": "^5.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
