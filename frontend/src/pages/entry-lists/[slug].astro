---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import type { CompetitionSummary, EntryRow } from "../../lib/types";
import { formatCount } from "../../lib/money";
const slug = Astro.params.slug!;
const q = (Astro.url.searchParams.get("q") ?? "").replace(/\D/g, "").slice(0, 8);
const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? 1) || 1);
const res = await Astro.locals.api.maybe<{ competition: CompetitionSummary; data: EntryRow[]; total: number; hasMore: boolean }>(`/api/entry-lists/${encodeURIComponent(slug)}?${new URLSearchParams({ q, page: String(page) })}`);
if (!res) return Astro.rewrite("/404");
const { competition: c, data: rows, total, hasMore } = res;
---
<Layout title={`Entry List — ${c.title}`} active="entry-lists">
  <section class="sec" style="padding-top:20px"><div class="mid stack g16">
    <a href="/entry-lists" class="row g8" style="color:#B9AFC6;text-decoration:none;font-weight:800;font-size:14px;min-height:44px"><Icon name="back" size={18} />All Entry Lists</a>
    <div class="card card-cy card-p stack g12">
      <div class="row g12"><img src={c.image} alt="" style="width:56px;height:56px;border-radius:12px;object-fit:cover" /><div style="flex:1"><h1 class="d" style="font-size:22px;margin:0">{c.title}</h1><div class="hint">{formatCount(total)} confirmed tickets</div></div></div>
      <form method="get" class="row g8"><input class="inp" name="q" inputmode="numeric" value={q} placeholder="Find a ticket number" aria-label="Find a ticket number" /><button class="btn btn-o" type="submit">Find</button></form>
      {rows.length ? <div style="overflow-x:auto"><table class="tbl"><thead><tr><th>Ticket</th><th>Name</th><th>Entry</th></tr></thead><tbody>{rows.map((r) => <tr><td><span class="tn">#{r.ticket}</span></td><td>{r.name}</td><td class="hint">{r.source === "postal" ? "Postal" : r.source === "free" ? "Free" : "Paid"}</td></tr>)}</tbody></table></div> : <div class="empty">{q ? "No ticket with that number." : "No confirmed tickets yet."}</div>}
      <div class="row g8" style="justify-content:center">{page > 1 && <a class="btn btn-o btn-sm" href={`?${new URLSearchParams({ q, page: String(page - 1) })}`}>Previous</a>}{hasMore && <a class="btn btn-o btn-sm" href={`?${new URLSearchParams({ q, page: String(page + 1) })}`}>Next</a>}</div>
    </div>
  </div></section>
</Layout>
