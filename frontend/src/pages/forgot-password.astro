---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { ForgotForm } from "../islands/AuthForms";
---
<Layout title="Reset Password" header="auth" headerBack="/login" bottomNav={false} footer={false} noindex>
  <section class="sec" style="padding-top:28px"><div class="narrow stack g16" style="max-width:440px">
    <a href="/login" class="row g8" style="color:#B9AFC6;text-decoration:none;font-weight:800;font-size:14px;min-height:44px"><Icon name="back" size={18} />Back To Log In</a>
    <div class="gg-rise"><h1 class="h1">Reset <span class="np gg-flicker">Password</span></h1><p class="p" style="margin-top:6px">Enter your email and we’ll send you a reset link.</p></div>
    <ForgotForm client:load />
  </div></section>
</Layout>
