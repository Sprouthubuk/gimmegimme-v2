---
import Layout from "../layouts/Layout.astro";
import type { InstantWinnerRow } from "../lib/types";
import { formatPence } from "../lib/money";
import { ago } from "../lib/time";
import { REVEAL_GAME_OPTIONS } from "../games/gameIds";
const game = Astro.url.searchParams.get("game");
const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? 1) || 1);
const q = new URLSearchParams({ limit: "30", page: String(page) });
if (game) q.set("game", game);
const { data: rows, hasMore } = await Astro.locals.api.get<{ data: InstantWinnerRow[]; hasMore: boolean }>(`/api/winners/instant?${q}`);
const games = REVEAL_GAME_OPTIONS.filter((g) => g.id !== "classic");
---
<Layout title="Instant Winners" active="instant-winners" description="Every instant win from the last 30 days.">
  <section class="sec" style="padding-top:20px"><div class="mid stack g16">
    <div class="gg-rise"><div class="row g8"><span class="gg-ping" style="width:8px;height:8px;border-radius:999px;background:#FF2DAA"></span><span class="eyebrow" style="color:#FF5CC0">Live Feed</span></div><h1 class="h1">Instant <span class="ny gg-flicker">Winners</span></h1><p class="p" style="margin-top:6px">Every instant win from the last 30 days. Could you be next?</p></div>
    <div class="row g8 gg-rise gg-d2"><a class="chip on" href="/instant-winners" aria-current="true">Instant Winners</a><a class="chip" href="/winners">Draw Winners</a></div>
    <div class="scrollx gg-rise gg-d3"><a class={`chip ${!game ? "on" : ""}`} href="/instant-winners">All Games</a>{games.map((g) => <a class={`chip ${game === g.id ? "on" : ""}`} href={`/instant-winners?game=${g.id}`}>{g.label}</a>)}</div>
    {rows.length ? <div class="card gg-stagger" style="overflow:hidden">{rows.map((w) => <div class="feed"><span class="av" style="background:#FF2DAA;box-shadow:0 0 12px rgba(255,45,170,.5)">{w.name.slice(0, 1)}</span><div style="flex:1;min-width:0"><div style="font-weight:800"><b>{w.name}</b> won <span class="ny">{w.prizeName.startsWith("£") || /\d/.test(w.prizeName) ? w.prizeName : formatPence(w.valuePence)}</span></div><div class="hint">{w.gameLabel ? `${w.gameLabel} · ` : ""}{w.competitionTitle}</div></div><span class="hint" style="white-space:nowrap">{ago(w.at)}</span></div>)}</div> : <div class="card empty">No instant wins yet{game ? " on this game" : ""} — the first winners are coming soon.</div>}
    <div class="row g8" style="justify-content:center">{page > 1 && <a class="btn btn-o" href={`/instant-winners?${new URLSearchParams({ ...(game ? { game } : {}), page: String(page - 1) })}`}>Newer</a>}{hasMore && <a class="btn btn-o" href={`/instant-winners?${new URLSearchParams({ ...(game ? { game } : {}), page: String(page + 1) })}`}>Load More</a>}</div>
  </div></section>
</Layout>
