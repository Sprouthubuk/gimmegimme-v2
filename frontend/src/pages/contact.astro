---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import ContactForm from "../islands/ContactForm";
const { me, site } = Astro.locals;
---
<Layout title="Contact Us">
  <section class="sec" style="padding-top:20px"><div class="wrap split">
    <div class="stack g16">
      <div class="gg-rise"><div class="eyebrow">Contact</div><h1 class="h1">Talk To <span class="np gg-flicker">Us</span></h1><p class="p" style="margin-top:6px">Questions about a comp, your wallet or a win? Send us a message.</p></div>
      <a class="card card-p row g12 gg-card" href="/faq" style="text-decoration:none;color:#fff"><span style="width:44px;height:44px;border-radius:14px;border:1px solid #22E6FF;color:#22E6FF;display:flex;align-items:center;justify-content:center"><Icon name="help" size={22} /></span><span style="flex:1"><b>Quick Answers</b><span class="hint" style="display:block">Most questions are covered in the FAQs</span></span><Icon name="chev" /></a>
      {site.socials.facebook && <a class="card card-p row g12 gg-card" href={site.socials.facebook} rel="noopener" target="_blank" style="text-decoration:none;color:#fff"><span style="width:44px;height:44px;border-radius:14px;border:1px solid #FF2DAA;color:#FF5CC0;display:flex;align-items:center;justify-content:center"><Icon name="fb" size={22} /></span><span style="flex:1"><b>Facebook Community</b><span class="hint" style="display:block">Join the group, post your wins</span></span><Icon name="chev" /></a>}
      <div class="card card-p stack g8">{site.supportEmail && <><span class="eyebrow">Email</span><a href={`mailto:${site.supportEmail}`} style="font-weight:900">{site.supportEmail}</a></>}<span class="eyebrow" style="margin-top:8px">Post</span><span class="muted" style="font-weight:700">GIMMEGIMMEPRIZES LTD, 57 Oakhanger Drive, Bristol, BS11 0RJ</span></div>
    </div>
    <ContactForm client:load name={me ? `${me.firstName} ${me.lastName}` : ""} email={me?.email ?? ""} />
  </div></section>
</Layout>
