---
import Layout from "../layouts/Layout.astro";
import { VerifyEmail } from "../islands/AuthForms";
import { safeNext } from "../lib/safe";
const next = Astro.url.searchParams.get("next");
const status = Astro.url.searchParams.get("status");
const me = Astro.locals.me;
const verified = status === "verified" || !!me?.emailVerified;
// The confirmation link carries where they were going (the checkout for the tickets they picked).
const go = safeNext(next, "/competitions");
const toCheckout = go.startsWith("/checkout") || go.startsWith("/basket");
---
<Layout title="Confirm Your Email" header="auth" bottomNav={false} footer={false} noindex>
  <section class="sec" style="padding-top:28px"><div class="narrow stack g16" style="max-width:480px">
    <div class="gg-rise">{verified
      ? <h1 class="h1 h1-one">You’re <span class="nc gg-flicker">All Set</span></h1>
      : <h1 class="h1 h1-one">Check Your <span class="nc gg-flicker">Inbox</span></h1>}</div>
    {verified
      ? <><div class="notice notice-c" role="status"><span>Email confirmed — you’re ready to play.</span></div><a class="btn btn-y btn-lg" href={go} data-testid="verified-go">{toCheckout ? "Carry On To Checkout" : "Let’s Go"}</a></>
      : <VerifyEmail client:load email={me?.email ?? null} next={next} />}
  </div></section>
</Layout>
