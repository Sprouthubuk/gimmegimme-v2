---
import { gameBadge } from "../lib/gameLabels";
import Layout from "../layouts/Layout.astro";
import CompCard from "../components/CompCard.astro";
import Countdown from "../components/Countdown.astro";
import HeroImage from "../components/HeroImage.astro";
import Icon from "../components/Icon.astro";
import type { CompetitionSummary, CompetitionDetail, InstantWinnerRow } from "../lib/types";
import { formatPence, formatCount } from "../lib/money";
import { ukDateTime, ukShortDay } from "../lib/time";

const { api, site } = Astro.locals;
const filter = Astro.url.searchParams.get("filter") ?? "all";
const { data: comps } = await api.get<{ data: CompetitionSummary[] }>("/api/competitions?status=live");
const instant = comps.filter((c) => c.type === "instant");
const draws = comps.filter((c) => c.type === "draw");
const featuredSlug = site.featuredSlug ?? comps.find((c) => c.featured)?.slug ?? instant[0]?.slug ?? null;
const featured = featuredSlug ? await api.maybe<CompetitionDetail>(`/api/competitions/${featuredSlug}`) : null;
const { data: winners } = await api.get<{ data: InstantWinnerRow[] }>("/api/winners/instant?limit=8");

const FILTERS: [string, string, (c: CompetitionSummary) => boolean][] = [
  ["all", "All", () => true],
  ["arcade", "Arcade", (c) => ["claw_machine", "slots", "coin_drop", "balloon_pop", "hook_a_duck", "spin_wheel"].includes(c.game ?? "")],
  ["reveal", "Scratch & Reveal", (c) => ["scratch_card", "classic", "gems", "bingo_card"].includes(c.game ?? "")],
  ["christmas", "Christmas", (c) => c.skin === "christmas"],
  ["under10", "Under 10p", (c) => c.pricePence < 10],
];
const active = FILTERS.find((f) => f[0] === filter) ?? FILTERS[0];
const shown = instant.filter(active[2]).slice(0, 8);
const ladder = featured?.prizes ?? [];
const prizesLeft = ladder.reduce((n, p) => n + (p.quantity - p.won), 0);
const prizesTotal = ladder.reduce((n, p) => n + p.quantity, 0);
const opensLater = featured?.status === "scheduled" && featured.opensAt ? featured.opensAt : null;
const nextDraw = draws.map((d) => d.drawAt).filter(Boolean).sort()[0] ?? null;
---
<Layout title="Home" active="home">
  {featured && (
    <section class="sec" style="padding-top:20px"><div class="wrap split hero-split">
      <div class="stack g16 hero-txt">
        <div class="row g8 gg-rise gg-d2"><span class="gg-ping" style="width:8px;height:8px;border-radius:999px;background:#FF2DAA;box-shadow:0 0 10px #FF2DAA"></span><span class="eyebrow" style="color:#FF5CC0">{opensLater ? `Coming soon · Opens ${ukDateTime(opensLater)}` : `Featured${prizesTotal ? ` · ${formatCount(prizesTotal)} instant wins` : ""}`}</span></div>
        <h1 class="h1 hero-title gg-rise gg-d2"><span class="np gg-flicker">{featured.title}</span></h1>
        <p class="p gg-rise gg-d3">{featured.subtitle ?? featured.description.slice(0, 120)}{featured.topPrizePence ? <> · Top prize <b class="ny">{formatPence(featured.topPrizePence, { short: false })}</b>.</> : null}</p>
        {opensLater && <div class="eyebrow gg-rise gg-d3" style="margin-bottom:-8px">Opens in</div>}
        <Countdown until={opensLater ?? featured.closesAt} size="xl" class="gg-rise gg-d3" />
        <div class="row g8 gg-rise gg-d5"><a class="btn btn-y btn-lg gg-cta" style="flex:1" href={`/competitions/${featured.slug}`}>{opensLater ? "See The Prizes" : `Play From ${formatPence(featured.pricePence)}`} <Icon name="arrow" size={18} stroke={3} /></a></div>
        <p class="hint gg-rise gg-d6" style="margin:0">18+ UK only · <a href="/free-entry">Free postal entry</a> · <a href="/legal/terms">T&amp;Cs</a></p>
      </div>
      <HeroImage src={featured.image} alt={featured.title} float class="hero-top">
        {gameBadge(featured) && <span class="tag tag-y" style="position:absolute;top:14px;left:14px;background:rgba(7,5,11,.88)"><Icon name="bolt" size={11} stroke={3} /> {gameBadge(featured)}</span>}
        {prizesTotal > 0 && <span class="gg-pop gg-d6" style="position:absolute;right:10px;bottom:14px;background:rgba(7,5,11,.9);border:1px solid #22E6FF;border-radius:14px;padding:8px 12px;box-shadow:0 0 20px rgba(34,230,255,.35)"><span class="eyebrow" style="display:block">Still to win</span><span class="d nc" style="font-size:22px">{formatCount(prizesLeft)} prizes</span></span>}
      </HeroImage>
    </div>
    {ladder.length > 0 && (
      <div class="wrap" style="margin-top:24px"><div style="border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);padding:12px 0;overflow:hidden" aria-label="Prize ladder">
        <div class="gg-marq">{[...ladder, ...ladder].map((p, i) => <span aria-hidden={i >= ladder.length ? "true" : undefined} style="white-space:nowrap;border:1px solid rgba(255,255,255,.12);border-radius:999px;padding:6px 12px;font-size:13px;font-weight:800"><span class="d" style="color:#FF5CC0">{formatPence(p.valuePence)}</span> <span class="dim">×</span> {formatCount(p.quantity)}</span>)}</div>
      </div></div>
    )}
    </section>
  )}

  <section id="instant"><div class="wrap stack g16">
    <div class="row between g12 gg-reveal sh"><div><div class="eyebrow">Buy · Play · Win Instantly</div><h2 class="h2"><span class="np">Instant</span> Wins</h2></div><a href="/competitions?type=instant" class="btn btn-o btn-sm">See All {instant.length}</a></div>
    <div class="scrollx" role="group" aria-label="Filter games">{FILTERS.map(([key, label]) => <a class={`chip ${key === active[0] ? "on" : ""}`} href={key === "all" ? "/#instant" : `/?filter=${key}#instant`} aria-current={key === active[0] ? "true" : undefined}>{label}</a>)}</div>
    {shown.length ? <div class="grid-c gg-stagger">{shown.map((c) => <CompCard c={c} />)}</div> : <div class="card empty">Nothing here right now — new games drop every week.</div>}
    <a href="/competitions" class="btn btn-o btn-block">View All Competitions <Icon name="arrow" size={18} /></a>
  </div></section>

  {draws.length > 0 && (
    <section class="sec"><div class="wrap stack g16">
      <div class="row between wrapx g12 gg-reveal sh"><div><div class="row g8"><span class="gg-ping" style="width:8px;height:8px;border-radius:999px;background:#22E6FF"></span><span class="eyebrow" style="color:#22E6FF">Live Draws</span></div><h2 class="h2">Next Draw {nextDraw && <span class="nc gg-flicker">{ukShortDay(nextDraw)}</span>}</h2></div></div>
      <div class="rail gg-stagger">{draws.map((c) => <CompCard c={c} />)}</div>
    </div></section>
  )}

  {winners.length > 0 && (
    <section style="border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);padding:16px 0"><div class="wrap row g16">
      <h2 class="d ny gg-flicker" style="font-size:22px;white-space:nowrap;margin:0">Just Won</h2>
      <div style="flex:1;min-width:0;overflow:hidden"><div class="gg-marq" style="animation-duration:28s">
        {[...winners, ...winners].map((w, i) => <span aria-hidden={i >= winners.length ? "true" : undefined} class="row g8" style="flex-shrink:0;border:1px solid rgba(255,242,58,.35);border-radius:999px;padding:5px 14px 5px 5px;font-size:13px;font-weight:700;color:#B9AFC6"><span class="av" style="width:28px;height:28px;background:#FF2DAA;font-size:13px">{w.name.slice(0, 1)}</span><b style="color:#fff">{w.name}</b> won <b style="color:#FFF23A">{w.prizeName}</b></span>)}
      </div></div>
      <a href="/instant-winners" class="dsk" style="font-weight:900;color:#fff;text-decoration:none;white-space:nowrap">All Winners →</a>
    </div></section>
  )}

  <section class="sec"><div class="wrap stack g20">
    <h2 class="h2 gg-reveal">How It <span class="nc">Works</span></h2>
    <div class="rail gg-stagger">
      <div class="card card-p stack g8 gg-card"><span class="d np" style="font-size:40px;line-height:1">01</span><h3 class="h3">Pick A Comp</h3><p class="p" style="font-size:14px">Arcade games, scratchcards, cash, tech, beauty — from 1p.</p></div>
      <div class="card card-p stack g8 gg-card"><span class="d nc" style="font-size:40px;line-height:1">02</span><h3 class="h3">Grab Tickets</h3><p class="p" style="font-size:14px">Pay from your wallet or by card. Or enter free by post.</p></div>
      <div class="card card-p stack g8 gg-card"><span class="d ny" style="font-size:40px;line-height:1">03</span><h3 class="h3">Play The Reveal</h3><p class="p" style="font-size:14px">One game per ticket. Results are fixed when you buy.</p></div>
      <div class="card card-p stack g8 gg-card"><span class="d np" style="font-size:40px;line-height:1">04</span><h3 class="h3">Bag Your Prize</h3><p class="p" style="font-size:14px">Wins land in your wallet instantly. Withdraw from {formatPence(site.minWithdrawalPence)}.</p></div>
    </div>
    <div class="trust">
      <div><Icon name="bolt" />Instant results</div><div><Icon name="mail" />Free postal entry</div><div><Icon name="shield" />Verifiable draws</div><div><Icon name="wallet" />Withdraw from {formatPence(site.minWithdrawalPence)}</div>
    </div>
  </div></section>
</Layout>
