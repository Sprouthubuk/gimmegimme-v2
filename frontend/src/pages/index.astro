---
import { gameBadge } from "../lib/gameLabels";
import Layout from "../layouts/Layout.astro";
import CompCard from "../components/CompCard.astro";
import Countdown from "../components/Countdown.astro";
import HeroImage from "../components/HeroImage.astro";
import Icon from "../components/Icon.astro";
import GimmeBoxBuilder from "../islands/GimmeBoxBuilder";
import type { CompetitionSummary, CompetitionDetail, InstantWinnerRow } from "../lib/types";
import { formatPence, formatCount } from "../lib/money";
import { ago, ukDateTime } from "../lib/time";

const { api, site } = Astro.locals;
// The independent calls run side by side once the visitor has a session (see api.hasSession).
const winnersCall = () => api.get<{ data: InstantWinnerRow[] }>("/api/winners/instant?limit=12");
const early = api.hasSession() ? winnersCall() : null;
early?.catch(() => undefined); // still rejects where it is awaited; this only stops an early failure crashing Node
const { data: comps } = await api.get<{ data: CompetitionSummary[] }>("/api/competitions?status=live");
const instant = comps.filter((c) => c.type === "instant");
const draws = comps.filter((c) => c.type === "draw");
const featuredSlug = site.featuredSlug ?? comps.find((c) => c.featured)?.slug ?? instant[0]?.slug ?? null;
const [featured, { data: winners }] = await Promise.all([
  featuredSlug ? api.maybe<CompetitionDetail>(`/api/competitions/${featuredSlug}`) : Promise.resolve(null),
  early ?? winnersCall(),
]);

const ladder = featured?.prizes ?? [];
const prizesLeft = ladder.reduce((n, p) => n + (p.quantity - p.won), 0);
const prizesTotal = ladder.reduce((n, p) => n + p.quantity, 0);
const opensLater = featured?.status === "scheduled" && featured.opensAt ? featured.opensAt : null;
// A scrolling strip loops by sliding exactly one copy along, so each copy must be wider than the
// widest screen: repeat short lists (about 16 pills is wider than 1440px), and pace it by length.
const loopOf = <T,>(items: T[], min = 16): T[] => (items.length ? Array.from({ length: Math.max(1, Math.ceil(min / items.length)) }, () => items).flat() : []);
const ladderLoop = loopOf(ladder);
const winnersLoop = loopOf(winners, 8);
---
<Layout title="Home" active="home" fullTitle="UK Prize Competitions & Instant Win Games | Gimme Gimme" description="Win cash, tech and more with UK online prize competitions from 1p: instant win games and live draws. 18+ UK only, free postal entry on every competition.">
  {featured && (
    <section class="sec" style="padding-top:20px"><div class="wrap split hero-split">
      <div class="stack g16 hero-txt">
        <div class="row g8 gg-rise gg-d2"><span class="gg-ping" style="width:8px;height:8px;border-radius:999px;background:#FF2DAA;box-shadow:0 0 10px #FF2DAA"></span><h1 class="eyebrow" style="color:#FF5CC0;margin:0">UK Prize Competitions · {opensLater ? `Coming soon · Opens ${ukDateTime(opensLater)}` : `Featured${prizesTotal ? ` · ${formatCount(prizesTotal)} instant wins` : ""}`}</h1></div>
        <h2 class="h1 hero-title gg-rise gg-d2"><span class="np gg-flicker">{featured.title}</span></h2>
        <p class="p gg-rise gg-d3">{featured.subtitle ?? featured.description.slice(0, 120)}{featured.topPrizePence ? <> · Top prize <b class="ny">{formatPence(featured.topPrizePence, { short: false })}</b>.</> : null}</p>
        {opensLater && <div class="eyebrow gg-rise gg-d3" style="margin-bottom:-8px">Opens in</div>}
        <Countdown until={opensLater ?? featured.closesAt} size="xl" class="gg-rise gg-d3" />
        <div class="row g8 gg-rise gg-d5"><a class="btn btn-y btn-lg gg-cta" style="flex:1" href={`/competitions/${featured.slug}`}>{opensLater ? "See The Prizes" : `Play From ${formatPence(featured.pricePence)}`} <Icon name="arrow" size={18} stroke={3} /></a></div>
        <p class="hint gg-rise gg-d6" style="margin:0">18+ UK only · <a href="/free-entry">Free postal entry</a> · <a href="/legal/terms">T&amp;Cs</a></p>
      </div>
      <HeroImage src={featured.image} srcset={featured.imageSrcset} alt={featured.title} float class="hero-top">
        {gameBadge(featured) && <span class="tag tag-y" style="position:absolute;top:14px;left:14px;background:rgba(7,5,11,.88)"><Icon name="bolt" size={11} stroke={3} /> {gameBadge(featured)}</span>}
        {prizesTotal > 0 && <span class="gg-pop gg-d6" style="position:absolute;right:10px;bottom:14px;background:rgba(7,5,11,.9);border:1px solid #22E6FF;border-radius:14px;padding:8px 12px;box-shadow:0 0 20px rgba(34,230,255,.35)"><span class="eyebrow" style="display:block">Still to win</span><span class="d nc" style="font-size:22px">{formatCount(prizesLeft)} prizes</span></span>}
      </HeroImage>
    </div>
    {winners.length > 0 ? (
      <div class="wrap" style="margin-top:24px"><div class="wfeed" aria-label="Live winners">
        <span class="wl"><span class="gg-ping"></span>Live <b>Winners</b></span>
        <div class="wm"><div class="gg-marq" data-winners={winners.map((w) => w.id).join()} style={`animation-duration:${winnersLoop.length * 4}s`}>
          {[...winnersLoop, ...winnersLoop].map((w, i) => (
            <span class="wp" aria-hidden={i >= winners.length ? "true" : undefined}><span class="av">{w.name.slice(0, 1)}</span><span><b>{w.name}</b> won <b class="ny">{w.prizeName}</b><small>{w.competitionTitle} · {ago(w.at)}</small></span></span>
          ))}
        </div></div>
        <a href="/instant-winners" class="dsk wa">All Winners →</a>
      </div></div>
    ) : ladder.length > 0 && (
      <div class="wrap" style="margin-top:24px"><div style="border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);padding:12px 0;overflow:hidden" aria-label="Prize ladder">
        <div class="gg-marq" style={`animation-duration:${ladderLoop.length * 3.5}s`}>{[...ladderLoop, ...ladderLoop].map((p, i) => <span aria-hidden={i >= ladder.length ? "true" : undefined} style="white-space:nowrap;border:1px solid rgba(255,255,255,.12);border-radius:999px;padding:6px 12px;font-size:13px;font-weight:800"><span class="d" style="color:#FF5CC0">{formatPence(p.valuePence)}</span> <span class="dim">×</span> {formatCount(p.quantity)}</span>)}</div>
      </div></div>
    )}
    </section>
  )}

  <section id="instant"><div class="wrap stack g16">
    <h2 class="h2 gg-reveal sh"><span class="np">Instant</span> Wins</h2>
    {instant.length ? <div class="grid-c gg-stagger">{instant.map((c) => <CompCard c={c} />)}</div> : <div class="card empty">New instant win games are on their way.</div>}
  </div></section>

  {draws.length > 0 && (
    <section id="draws" class="sec"><div class="wrap stack g16">
      <h2 class="h2 gg-reveal sh"><span class="nc">Live</span> Draws</h2>
      <div class="grid-c gg-stagger">{draws.map((c) => <CompCard c={c} />)}</div>
    </div></section>
  )}

  {site.gimmeBox && (
    <section id="gimme-box" class="sec"><div class="wrap stack g16">
      <div class="stack g8">
        <h2 class="h2 gg-reveal sh">Gimme <span class="np">Box</span></h2>
        <p class="p" style="margin:0">Can't decide? Set a budget and we'll pack a mix of live draw tickets for you{site.gimmeBox.bonusPct > 0 ? <>, plus <b class="ny">{site.gimmeBox.bonusPct}% bonus tickets</b> free</> : null}.</p>
      </div>
      <GimmeBoxBuilder client:visible available={site.gimmeBox.available} chipsPence={site.gimmeBox.chipsPence} minPence={site.gimmeBox.minPence} maxPence={site.gimmeBox.maxPence} bonusPct={site.gimmeBox.bonusPct} />
    </div></section>
  )}

  <section class="sec"><div class="wrap stack g20">
    <h2 class="h2 gg-reveal">How It <span class="nc">Works</span></h2>
    <div class="rail gg-stagger">
      <div class="card card-p stack g8 gg-card"><span class="d np" style="font-size:40px;line-height:1">01</span><h3 class="h3">Pick A Comp</h3><p class="p" style="font-size:14px">Instant wins and live draws for cash, tech and more. Tickets from 1p.</p></div>
      <div class="card card-p stack g8 gg-card"><span class="d nc" style="font-size:40px;line-height:1">02</span><h3 class="h3">Grab Tickets</h3><p class="p" style="font-size:14px">Pay from your wallet or by card, or enter free by post. Ticket numbers are given at random.</p></div>
      <div class="card card-p stack g8 gg-card"><span class="d ny" style="font-size:40px;line-height:1">03</span><h3 class="h3">Win Prizes</h3><p class="p" style="font-size:14px">Instant wins show in your reveal game straight away. Live draws are drawn on the date shown. Cash wins go to your wallet.</p></div>
    </div>
  </div></section>
  <section class="sec"><div class="wrap stack g12" style="max-width:760px">
    <h2 class="h2 gg-reveal">Online Prize Competitions <span class="np">In The UK</span></h2>
    <p class="p">Gimme Gimme Prizes runs online competitions for players in the UK aged 18 and over. Choose an <a href="/competitions?type=instant">instant win competition</a> and play a reveal game to see straight away whether your ticket has won, or enter a <a href="/competitions?type=draw">live draw</a> for a bigger prize, drawn when the competition closes.</p>
    <p class="p">Tickets start from 1p and every ticket number is given at random. Winning ticket numbers and entry lists are public, every winner is published on our <a href="/winners">winners page</a>, and every competition can be entered for free by post: see <a href="/free-entry">free postal entry</a> or read <a href="/how-it-works">how it works</a>.</p>
  </div></section>
<script>
  import { ago } from "../lib/time";
  // Keeps the featured winners feed live: new winners every minute, built with textContent (never HTML).
  const strip = document.querySelector<HTMLElement>("[data-winners]");
  type W = { id: string; name: string; prizeName: string; competitionTitle: string; at: string };
  let shown = strip?.dataset.winners ?? "";
  const pill = (w: W, copy: boolean) => {
    const el = document.createElement("span");
    el.className = "wp";
    if (copy) el.setAttribute("aria-hidden", "true");
    const av = el.appendChild(document.createElement("span")); av.className = "av"; av.textContent = w.name.slice(0, 1);
    const tx = el.appendChild(document.createElement("span"));
    tx.append(Object.assign(document.createElement("b"), { textContent: w.name }), " won ", Object.assign(document.createElement("b"), { textContent: w.prizeName, className: "ny" }));
    tx.appendChild(document.createElement("small")).textContent = `${w.competitionTitle} · ${ago(w.at)}`;
    return el;
  };
  const refresh = async () => {
    try {
      const res = await fetch("/api/winners/instant?limit=12", { headers: { Accept: "application/json" }, credentials: "same-origin" });
      if (!res.ok) return;
      const list: W[] = (await res.json()).data ?? [];
      const key = list.map((w) => w.id).join();
      if (!strip || !list.length || key === shown) return;
      shown = key;
      const loop = Array.from({ length: Math.max(1, Math.ceil(8 / list.length)) }, () => list).flat();
      strip.replaceChildren(...[...loop, ...loop].map((w, i) => pill(w, i >= list.length)));
      strip.style.animationDuration = `${loop.length * 4}s`;
    } catch { /* keep what is showing */ }
  };
  if (strip) setInterval(refresh, 60_000);
</script>
</Layout>
