---
import Layout from "../layouts/Layout.astro";
import { ResetForm } from "../islands/AuthForms";
const token = (Astro.url.searchParams.get("token") ?? "").slice(0, 200);
const email = (Astro.url.searchParams.get("email") ?? "").slice(0, 200);
---
<Layout title="Choose A New Password" header="auth" headerBack="/login" bottomNav={false} footer={false} noindex>
  <section class="sec" style="padding-top:28px"><div class="narrow stack g16" style="max-width:440px">
    <div class="gg-rise"><h1 class="h1">New <span class="np gg-flicker">Password</span></h1><p class="p" style="margin-top:6px">For {email || "your account"}.</p></div>
    <ResetForm client:load token={token} email={email} />
  </div></section>
</Layout>
