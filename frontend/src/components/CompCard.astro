---
import { gameBadge } from "../lib/gameLabels";
import Icon from "./Icon.astro";
import type { CompetitionSummary } from "../lib/types";
import { formatPence } from "../lib/money";
import { endsIn, ukShortDay } from "../lib/time";
interface Props { c: CompetitionSummary }
const { c } = Astro.props;
const live = c.type === "draw";
const href = `/competitions/${c.slug}`;
const closed = c.status !== "live";
---
<a class="cc gg-card" href={href}>
  <div class="im">
    <img src={c.image} alt={c.title} loading="lazy" width="400" height="400">
    {live
      ? <span class="gt cy"><Icon name="live" size={11} stroke={2.6} />Live Draw</span>
      : <span class="gt"><Icon name="bolt" size={10} stroke={3} />{gameBadge(c) ?? "Instant Win"}</span>}
    <span class="en" data-ends={closed ? undefined : c.closesAt}><Icon name="clock" size={11} stroke={2.6} />{closed ? (c.status === "sold_out" ? "Sold out" : "Closed") : endsIn(c.closesAt)}</span>
  </div>
  <div class="bd">
    <div class="tt">{c.title}</div>
    <div class="pr">
      <div><div class="sm">Per ticket</div><div class="pp np">{formatPence(c.pricePence)}</div></div>
      <div><div class="sm" style="text-align:right">{live ? "Draw" : "Top prize"}</div><span class="tp ny">{live ? (c.drawAt ? ukShortDay(c.drawAt) : "Live") : (c.topPrizePence ? formatPence(c.topPrizePence, { short: false }) : "")}</span></div>
    </div>
    <div class={`bar ${live ? "cy" : ""}`}><div class="gg-shine" style={`width:${Math.max(0, Math.min(100, c.soldPercent))}%`}></div></div>
    <div class="row between"><span class="sm">{c.soldPercent}% sold</span>{c.subtitle && <span class="sm">{c.subtitle}</span>}</div>
    <span class="btn btn-y btn-block go">{closed ? "View" : live ? "Enter Draw" : "Play Now"}</span>
  </div>
</a>
