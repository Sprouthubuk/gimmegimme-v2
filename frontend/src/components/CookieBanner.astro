---
import { createHash } from "node:crypto";
/** Asks once about marketing cookies (the Meta Pixel). Shown only when a Pixel ID is set in the admin. */
const pixelId = Astro.locals.site.metaPixelId ?? "";
// Signed-in players: hashed here (SHA-256, as Meta asks), so the plain email never sits in the page for the Pixel.
const me = Astro.locals.me;
const sha = (v: string) => createHash("sha256").update(v).digest("hex");
const em = me ? sha(me.email.trim().toLowerCase()) : undefined;
const xid = me ? sha(String(me.id)) : undefined;
// Shown straight away (in the page itself, not after a script) unless this browser has already chosen.
const chosen = ["accepted", "rejected"].includes(Astro.cookies.get("gg_consent")?.value ?? "");
---
{pixelId && (
  <div class="ck" id="cookie-banner" data-pixel={pixelId} data-em={em} data-xid={xid} role="dialog" aria-live="polite" aria-label="Cookie choice" hidden={chosen || undefined}>
    <p class="ck-t">We'd like to use Meta's advertising cookies, and tell Meta when you join or buy, to see which of our ads work, but only if you accept. <a href="/legal/cookies">Cookie policy</a></p>
    {/* Reject and Accept look and work the same: same size, same style, neither picked for you. */}
    <div class="ck-b">
      <button type="button" class="ck-btn" data-choice="rejected">Reject</button>
      <button type="button" class="ck-btn" data-choice="accepted">Accept</button>
    </div>
  </div>
)}
<script>
  import { readConsent, saveConsent, startPixel, syncConsentCookie } from "../lib/consent";
  syncConsentCookie();
  const banner = document.getElementById("cookie-banner");
  const id = banner?.dataset.pixel ?? "";
  // Sits above whatever is fixed to the bottom of the screen (the menu, a competition's buy bar), never under it.
  const lift = () => {
    if (!banner || banner.hidden) return;
    let h = 0;
    document.querySelectorAll<HTMLElement>(".bn, .buybar").forEach((el) => {
      const r = el.getBoundingClientRect();
      // Only a bar actually sitting on the bottom edge counts (not one sliding away or parked off-screen).
      if (r.height && getComputedStyle(el).display !== "none" && r.top >= 0 && r.top < innerHeight && r.bottom >= innerHeight - 4) h = Math.max(h, innerHeight - r.top);
    });
    banner.style.bottom = h ? `${Math.round(h + 12)}px` : "";
  };
  // Totals only: which button was pressed, nothing about who. Sets nothing on the device.
  const count = (choice: string) => {
    const body = JSON.stringify({ choice });
    try {
      if (navigator.sendBeacon?.("/api/consent-choice", new Blob([body], { type: "application/json" }))) return;
    } catch {
      // fall through
    }
    fetch("/api/consent-choice", { method: "POST", body, keepalive: true, credentials: "omit", headers: { "Content-Type": "application/json", Accept: "application/json" } }).catch(() => {});
  };
  if (banner && id) {
    if (readConsent() === null) {
      banner.hidden = false;
      lift();
      addEventListener("resize", lift);
      addEventListener("load", lift);
      // The buy bar slides in as the page scrolls: follow it.
      let queued = false;
      addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; lift(); }); } }, { passive: true });
      new MutationObserver(lift).observe(document.body, { attributes: true, subtree: true, attributeFilter: ["class", "hidden", "style"] });
    } else {
      banner.hidden = true;
      startPixel(id);
    }
    banner.querySelectorAll<HTMLButtonElement>("[data-choice]").forEach((b) =>
      b.addEventListener("click", () => {
        const choice = b.dataset.choice as "accepted" | "rejected";
        const had = readConsent();
        saveConsent(choice);
        banner.hidden = true;
        count(choice);
        // Withdrawing stops the Pixel straight away: reload without it.
        if (had === "accepted" && choice === "rejected") location.reload();
        else startPixel(id);
      }),
    );
    document.querySelectorAll("[data-cookie-settings]").forEach((el) =>
      el.addEventListener("click", (e) => {
        e.preventDefault();
        banner.hidden = false;
        lift();
        banner.querySelector<HTMLButtonElement>("[data-choice='rejected']")?.focus();
      }),
    );
  } else {
    // No Pixel set: there is nothing to choose, so the footer link just goes to the policy.
    document.querySelectorAll<HTMLElement>("[data-cookie-settings]").forEach((el) => (el.hidden = true));
  }
</script>
<style>
  .ck { font-family: Nunito, system-ui, sans-serif; position: fixed; left: 12px; right: 12px; bottom: 96px; z-index: 70; max-width: 520px; margin: 0 auto; padding: 14px; border-radius: 18px; background: #0e0914; border: 1px solid rgba(255, 45, 170, 0.55); box-shadow: 0 0 40px rgba(255, 45, 170, 0.18), 0 18px 40px rgba(0, 0, 0, 0.55); color: #fff; }
  .ck[hidden] { display: none; }
  .ck-t { margin: 0 0 12px; font-size: 14px; line-height: 1.5; font-weight: 600; color: #d8d0e2; }
  .ck-t a { color: #ff5cc0; }
  .ck-b { display: flex; gap: 10px; }
  .ck-btn { flex: 1 1 0; min-height: 48px; border-radius: 999px; border: 2px solid #fff; background: #1b1424; color: #fff; font: 800 16px Nunito, system-ui, sans-serif; cursor: pointer; }
  .ck-btn:focus-visible { outline: 3px solid #ff5cc0; outline-offset: 2px; }
  @media (min-width: 900px) { .ck { bottom: 20px; } }
</style>
